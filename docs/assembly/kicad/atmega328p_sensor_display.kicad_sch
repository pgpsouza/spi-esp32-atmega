) (at 142.24 129.54 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e38ce2b1-bd57-4f38-9f3c-83a8327c7c7a")) (text "OLED no ESP32-S3: I2C em GPIO8 (SDA) e GPIO9 (SCL), alimentado em 3,3 V.\nConferir a ordem dos pinos na serigrafia do modulo e o endereco I2C (0x3C)." (exclude_from_sim no) (at 50.8 129.54 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c19bb997-135a-4b57-b10b-b142557ba6e0")) (text "Sensor: curva de conversao ADC -> temperatura a definir no firmware." (exclude_from_sim no) (at 50.8 137.16 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "951e0d7a-84f7-459a-9069-d21dd1837c11")) (sheet_instances (path "/" (page "1"))) (embedded_fonts no))
